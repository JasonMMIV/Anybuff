{
  "name": "anybuff-desktop",
  "version": "0.1.0-beta.4",
  "description": "AnyBuff Desktop — Windows GUI for the AnyBuff local-first BYOK coding agent",
  "author": "AnyBuff",
  "private": true,
  "main": "./bootstrap.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-launcher.mjs dev",
    "build": "electron-vite build",
    "preview": "node scripts/dev-launcher.mjs preview",
    "start": "node scripts/dev-launcher.mjs preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "node scripts/pre-dist.mjs && electron-vite build && electron-builder --win --publish never && node scripts/smoke-packaged.mjs",
    "smoke:packaged": "node scripts/smoke-packaged.mjs"
  },
  "dependencies": {
    "@codebuff/sdk": "*",
    "dompurify": "^3.4.13",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.9",
    "marked-highlight": "^2.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "typescript5": "npm:typescript@^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "43.4.1",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "vite": "^7.3.6"
  }
}
