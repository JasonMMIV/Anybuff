<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Loopback HTTP for the local WS host; network for rootfs/Node download + LLM APIs -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Foreground service: the engine keeps running while the screen is off (M-B4) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".AnyBuffApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.AnyBuff">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Engine foreground service (specialUse, M-B4). The proot/Node host
             runs here while the app is backgrounded; the user starts it by
             sending a task, and the notification shows progress + a stop
             action. dataSync is deliberately NOT used (6h/day cap, ADR). -->
        <service
            android:name=".engine.EngineService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="On-device AI coding agent: runs a local sandboxed Node.js engine (proot) for user-initiated long-running tasks." />
        </service>
    </application>
</manifest>
