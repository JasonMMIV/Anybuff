<?xml version="1.0" encoding="utf-8"?>
<!-- FileProvider share roots (gap #14): the sandboxed workspace copies live
     under filesDir/workspaces — bound at /workspace, /upload, /skills inside
     the proot guest (see ProotRunner). One files-path covers all three.
     cache-path: engine-log export (Settings → Engine → Share Log) writes
     anybuff-engine-log.txt to cacheDir/shared and shares it via ACTION_SEND. -->
<paths>
    <files-path name="workspaces" path="workspaces/" />
    <cache-path name="shared" path="shared/" />
</paths>
